# Copier en .env (local) ou saisir dans Railway/Render. Ne jamais committer .env
DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/ecole
JWT_SECRET=chaine-aleatoire-d-au-moins-32-caracteres
# Jeton à usage unique pour créer le 1er administrateur (route /api/setup)
SETUP_TOKEN=autre-chaine-aleatoire
# En local sur Windows : NODE_ENV=development ; sur Railway/Render : production
NODE_ENV=development
